# TechDoc AI Environment Configuration

# Database
# Default: Zero-config SQLite. Or configure PostgreSQL with pgvector:
DATABASE_URL=sqlite:///./techdoc_ai.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/techdoc_ai

# Security
JWT_SECRET=techdoc-ai-super-secret-production-key-2026

# AI Providers
DEFAULT_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional External API Keys (Leave blank for zero-cost local operation)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Retrieval Hyperparameters
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
DEFAULT_CHUNK_SIZE=600
DEFAULT_CHUNK_OVERLAP=120
DEFAULT_TOP_K=5
DENSE_WEIGHT=0.65
SPARSE_WEIGHT=0.35
ENABLE_RERANKER=true
